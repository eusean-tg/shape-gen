# Machine-local dependencies, downloaded weights and private API state.
/.venv*/
/venv/
/.toolchain/
/third_party/
/models/
/var/

# Preserve source, documentation and small reports inside experiment/handoff
# folders. Everything else in these folders (including future binaries) is ignored.
/assets/**
/exports/**
!/assets/**/
!/exports/**/
!/assets/**/*.py
!/assets/**/*.js
!/assets/**/*.mjs
!/assets/**/*.jsx
!/assets/**/*.ts
!/assets/**/*.tsx
!/assets/**/*.html
!/assets/**/*.css
!/assets/**/*.md
!/assets/**/*.json
!/assets/**/*.yaml
!/assets/**/*.yml
!/assets/**/*.txt
!/assets/**/LICENSE*
!/assets/**/NOTICE*
!/exports/**/*.py
!/exports/**/*.js
!/exports/**/*.mjs
!/exports/**/*.jsx
!/exports/**/*.ts
!/exports/**/*.tsx
!/exports/**/*.md
!/exports/**/*.json
!/exports/**/SHA256SUMS

# Generated geometry arrays are meshes even when serialized as JSON.
/assets/**/*-mesh.json
/assets/**/mesh.json

# Generated binary assets, checkpoints, archives and downloaded papers anywhere.
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.gguf
*.npy
*.npz
*.blend
*.blend[0-9]*
*.glb
*.gltf
*.fbx
*.obj
*.ply
*.stl
*.png
*.jpg
*.jpeg
*.webp
*.exr
*.wav
*.mp3
*.flac
*.ogg
*.mp4
*.webm
*.pdf
*.zip
# Small immutable source/documentation releases must travel with their manifests.
!/exports/blender-helpers/*/bundle.zip
*.tar
*.gz
*.7z
*.whl
*.so
*.o

# Caches, logs and build output (also override source allowlists above).
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
node_modules/
/dist/
/build/
*.egg-info/
*.log
*.tmp
*.incomplete
.DS_Store

# Credentials and local overrides. Templates with placeholders may be tracked.
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
api-token
api-token.*
credentials.json
secrets.json
