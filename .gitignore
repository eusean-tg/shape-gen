# Machine-local dependencies, downloaded weights and private API state.
/.venv*/
/venv/
/.toolchain/
/third_party/
/models/
/var/

# Local generated assets; retain only the directory placeholder.
/assets/*
!/assets/.gitkeep

# Machine-local generated configuration and deployment unit.
/config/unirig/
/config/shape-gen-api.service

# Generated exports stay local. Retain the two maintained consumer distributions.
/exports/**
!/exports/blender-helpers/
!/exports/blender-helpers/*/
!/exports/blender-helpers/*/manifest.json
!/exports/blender-helpers/*/release.json
!/exports/shape-gen-api/
!/exports/shape-gen-api/README.md
!/exports/shape-gen-api/agent.md
!/exports/shape-gen-api/blender-handoff.md
!/exports/shape-gen-api/geometry-experiments.md
!/exports/shape-gen-api/motion-diagnostics.md
!/exports/shape-gen-api/shape_api_client.py
!/exports/shape-gen-api/SHA256SUMS

# Generated binary assets, checkpoints, archives and downloaded papers anywhere.
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.gguf
*.npy
*.npz
*.blend
*.blend[0-9]*
*.glb
*.gltf
*.fbx
*.obj
*.ply
*.stl
*.png
*.jpg
*.jpeg
*.webp
*.exr
*.wav
*.mp3
*.flac
*.ogg
*.mp4
*.webm
*.pdf
*.zip
# Small immutable source/documentation releases must travel with their manifests.
!/exports/blender-helpers/*/bundle.zip
*.tar
*.gz
*.7z
*.whl
*.so
*.o

# Caches, logs and build output (also override source allowlists above).
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
node_modules/
/dist/
/build/
*.egg-info/
*.log
*.tmp
*.incomplete
.DS_Store

# Credentials and local overrides. Templates with placeholders may be tracked.
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
api-token
api-token.*
credentials.json
secrets.json
