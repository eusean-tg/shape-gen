[Unit]
Description=Shape-gen authenticated job API and serial GPU worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/sean/workspace/shape-gen
ExecStart=/home/sean/workspace/shape-gen/.venv-api/bin/python -m uvicorn shape_api.server:app --host 100.66.127.115 --port 8765 --workers 1 --no-access-log --timeout-graceful-shutdown 5
Environment=PYTHONUNBUFFERED=1
Environment=SHAPE_API_TOKEN_FILE=/home/sean/.config/shape-gen/api-token
UMask=0077
KillMode=control-group
TimeoutStopSec=15
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
