+# Local inference-only setup: postprocess requires texture/mesh packages that
+# LATO.2's mesh-to-voxel path never uses. Keep it available on explicit access.
+def __getattr__(name):
+    if name == 'postprocess':
+        import importlib
+        module = importlib.import_module('.postprocess', __name__)
+        globals()[name] = module
+        return module
+    raise AttributeError(name)
